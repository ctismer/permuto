# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
# what a build leaves behind.  Named here and not only in somebody's global
# ignore file, so a fresh clone stays clean after `pip install -e .`
/build/
/dist/

# user session files saved while playing (root only; the 1995 .ply/.nod
# under legacy/ are project data and stay tracked)
/*.pms
/*.ply
/xanti

# pictures written by the CLI into the working directory (render, export,
# kugel). The ones in docs/demo/ are project data and stay tracked.
/*.png
/*.ps
